{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "season": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2100
    },
    "week": {
      "type": "integer",
      "minimum": 1,
      "maximum": 22
    },
    "model_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "type": "string",
      "const": "research"
    },
    "frozen": {
      "type": "boolean"
    },
    "payload": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "dek": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "games": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "eventId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000
              },
              "matchup": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000
              },
              "headline": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000
              },
              "thesis": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000
              },
              "defensiveWeakness": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000
              },
              "offensiveResponse": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000
              },
              "personnelContext": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000
              },
              "gameflow": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000
              },
              "breaker": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000
              },
              "sources": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 6000
                    },
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https:\\/\\/.*"
                    },
                    "published_at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                    }
                  },
                  "required": [
                    "title",
                    "url",
                    "published_at"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "eventId",
              "matchup",
              "headline",
              "thesis",
              "defensiveWeakness",
              "offensiveResponse",
              "personnelContext",
              "gameflow",
              "breaker",
              "sources"
            ],
            "additionalProperties": false
          }
        },
        "qualifiedProps": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "eventId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000
              },
              "player": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000
              },
              "marketKey": {
                "type": "string",
                "pattern": "^player_.*"
              },
              "side": {
                "type": "string",
                "enum": [
                  "OVER",
                  "UNDER"
                ]
              },
              "line": {
                "type": "number"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "grade": {
                "type": "string",
                "enum": [
                  "A",
                  "A-",
                  "B+",
                  "B",
                  "Pass"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000
              },
              "tags": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 6000
                }
              },
              "sources": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 6000
                    },
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https:\\/\\/.*"
                    },
                    "published_at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                    }
                  },
                  "required": [
                    "title",
                    "url",
                    "published_at"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "eventId",
              "player",
              "marketKey",
              "side",
              "line",
              "score",
              "grade",
              "reason",
              "tags",
              "sources"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "dek",
        "games",
        "qualifiedProps"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "season",
    "week",
    "model_version",
    "generated_at",
    "content_hash",
    "kind",
    "frozen",
    "payload"
  ],
  "additionalProperties": false
}
