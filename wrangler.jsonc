{
  "name": "signal-research-importer",
  "main": "index.mjs",
  "account_id": "21e6bfe156cfc23339daf4eb198bebfa",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "GITHUB_REPOSITORY_URL": "https://github.com/davidrogers194/SIGNAL_DATA",
    "GITHUB_BRANCH": "main",
    "SIGNAL_SITE_URL": "https://signal-site-contents.davidrogers194.workers.dev",
    "RESEARCH_TASK_URL": "https://chatgpt.com/scheduled/6aa7741a2ee0819186360c09dc8a3a46",
    "RESEARCH_SCHEDULE_VERIFIED_AT": "2026-09-21T03:44:23.799827+00:00"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "signal",
      "database_id": "0f8e5711-f5e4-4ad8-9dfb-5908819e2d3c"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "SIGNAL_SITE",
      "service": "signal-site-contents"
    }
  ]
}
